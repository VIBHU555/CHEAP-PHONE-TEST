# Copy to .env or export in your shell. NOTHING here is required to run the app.
# Optional: enables "Add LLM explanations" in reports (server-side only; never sent to the browser)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Backend
POCKETTEST_PORT=8000
POCKETTEST_DB=backend/data/pockettest.sqlite3
POCKETTEST_MAX_CONCURRENT=1
# Registered targets: demo app + optional extra authorised origins (comma-separated, exact origins)
POCKETTEST_DEMO_URL=http://127.0.0.1:5055
POCKETTEST_ALLOWED_TARGETS=
DEMO_PORT=5055
